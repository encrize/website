# Copy to ~/.config/encrize-devices/linux-laptop.env and chmod 600.
DEVICE_TOKEN=replace_with_linux_laptop_secret
API_URL=https://encrize.vip/api/devices/linux-laptop
# Comma-separated public tags.
ACCESSORIES=mouse,headphones
# Override if auto-detection fails.
# BATTERY_PATH=/sys/class/power_supply/BAT0
