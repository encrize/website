<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>vip.encrize.device-reporter</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/encrize-report-device-macos</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/encrize-device-reporter.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/encrize-device-reporter.err</string>
</dict>
</plist>
